NODE_ENV=development
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long
PORT=3000
DATABASE_URL=postgresql://chai_song:replace_this_password@localhost:5432/chai_and_song
ALLOWED_ORIGINS=

# Public HTTPS API origin only, used when the Express-served frontend calls
# an API on another origin. For a static frontend, set its public config.js.
# Leave empty for the usual same-origin Express setup.
# Never put database credentials or private keys in this setting.
API_BASE_URL=

# Spotify Developer API credentials (optional, enables live search across 100M+ Spotify songs)
# Get your Client ID and Client Secret from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
